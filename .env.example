# ==============================================================================
# AgriChain Agentic AI (v2.2 Selective-LLM Hybrid) — Environment Configuration
# ==============================================================================
# Mode: "SIMULATED" (deterministic offline benchmark) or "LIVE" (real LLM APIs)
LLM_EXECUTION_MODE=SIMULATED

# External LLM API Keys (ONLY 3 Cognitive Agents use LLM when LLM_EXECUTION_MODE=LIVE):
#   - AGT-02 Koperasi Tani        -> Anthropic Claude 3.5 Sonnet
#   - AGT-03 FreshFood Processing -> Google Gemini 2.5 Flash (Multimodal)
#   - AGT-06 Global Orchestrator  -> OpenAI GPT-4o
# Non-LLM Deterministic ML/Optimization Agents (0 LLM tokens): AGT-01 AgroFarm, AGT-04 ColdChain, AGT-05 SuperMart
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Active Model Routing Table (3 Heterogeneous LLMs + 3 Deterministic ML/Rule Agents)
MODEL_AGROFARM=deterministic/rf250-ndvi-rules
MODEL_KOPERASI=anthropic/claude-3-5-sonnet-20241022
MODEL_FRESHFOOD=gemini/gemini-2.5-flash
MODEL_COLDCHAIN=deterministic/iforest-xgbeta-vrptw
MODEL_SUPERMART=deterministic/xgb7d-newsvendor-rules
MODEL_ORCHESTRATOR=openai/gpt-4o

# Heterogeneous Database URLs (Docker Compose)
AGROFARM_DB_URL=postgresql://agro_user:agro_pass@localhost:5432/agrofarm_db
KOPERASI_DB_URL=mysql+pymysql://kop_user:kop_pass@localhost:3306/koperasi_db
FRESHFOOD_MONGO_URL=mongodb://localhost:27017/freshfood_db
COLDCHAIN_DB_URL=postgresql://cc_user:cc_pass@localhost:5433/coldchain_tsdb
SUPERMART_DB_URL=mysql+pymysql://sm_user:sm_pass@localhost:3307/supermart_db
REDIS_URL=redis://localhost:6379/0

# NIST AI RMF 1.0 HITL Escalation Thresholds
HITL_MAX_FLR_PCT=10.0
HITL_CAPACITY_DROP_PCT=40.0
HITL_COST_SURGE_PCT=15.0
MAX_NEGOTIATION_ROUNDS=3
RANDOM_SEED=42
