# ==============================================================================
# AgriChain Agentic AI (v2.2 Selective-LLM Hybrid) — Environment Configuration
# ==============================================================================
# Mode: "SIMULATED" (offline deterministic benchmark) or "LIVE" (real Free/Paid LLM APIs)
LLM_EXECUTION_MODE=SIMULATED

# ------------------------------------------------------------------------------
# 100% FREE-TIER EXTERNAL LLM APIs (0 USD, Tanpa Kartu Kredit!)
# Cukup isi 2 key gratis ini (atau bahkan 1 key saja -> otomatis fallback!):
#   1. Groq Cloud (Gratis):      https://console.groq.com/keys
#   2. Google AI Studio (Gratis): https://aistudio.google.com/apikey
#   3. OpenRouter (Opsional :free): https://openrouter.ai/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# 3 Model LLM Gratis Heterogen untuk 3 Agen Kognitif (bisa diubah sesuai console):
#   - AGT-02 Koperasi Tani        -> Groq: llama-3.3-70b-versatile (fallback: gpt-oss-20b / gemini)
#   - AGT-03 FreshFood Processing -> Google AI Studio: gemini-2.5-flash (multimodal)
#   - AGT-06 Global Orchestrator  -> Groq: openai/gpt-oss-120b (fallback: llama-3.3-70b / gemini)
# (Agen AGT-01 AgroFarm, AGT-04 ColdChain, AGT-05 SuperMart = No LLM / Deterministic ML + Rules)
GROQ_MODEL_KOPERASI=openai/gpt-oss-20b
GEMINI_MODEL_FRESHFOOD=gemini-3.5-flash-lite
GROQ_MODEL_GLOBAL=openai/gpt-oss-120b
OPENROUTER_MODEL_FALLBACK=meta-llama/llama-3.3-70b-instruct:free

# Opsional: Paid Cloud API Keys (otomatis diprioritaskan jika diisi)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Heterogeneous Database URLs (Docker Compose)
AGROFARM_DB_URL=postgresql://agro_user:agro_pass@localhost:5432/agrofarm_db
KOPERASI_DB_URL=mysql+pymysql://kop_user:kop_pass@localhost:3306/koperasi_db
FRESHFOOD_MONGO_URL=mongodb://localhost:27017/freshfood_db
COLDCHAIN_DB_URL=postgresql://cc_user:cc_pass@localhost:5433/coldchain_tsdb
SUPERMART_DB_URL=mysql+pymysql://sm_user:sm_pass@localhost:3307/supermart_db
REDIS_URL=redis://localhost:6379/0

# NIST AI RMF 1.0 HITL Escalation Thresholds
HITL_MAX_FLR_PCT=10.0
HITL_CAPACITY_DROP_PCT=40.0
HITL_COST_SURGE_PCT=15.0
MAX_NEGOTIATION_ROUNDS=3
RANDOM_SEED=42
